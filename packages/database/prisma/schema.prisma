datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MEMBER
  ADMIN
  HUB_MANAGER
  SUPPLIER
}

enum PoolStatus {
  DRAFT
  OPEN
  LOCKED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  DISBURSED
  REFUNDED
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  READY_FOR_COLLECTION
  COLLECTED
  CANCELLED
}

model User {
  id          String        @id @default(uuid())
  phoneNumber String        @unique
  fullName    String
  role        Role          @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships GroupMember[]
  orders      Order[]
  managedHubs PickupHub[]   @relation("HubManager")

  @@index([phoneNumber])
}

model StokvelGroup {
  id          String        @id @default(uuid())
  name        String
  description String?
  code        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  pools       BuyingPool[]
}

model GroupMember {
  id       String       @id @default(uuid())
  userId   String
  groupId  String
  joinedAt DateTime     @default(now())
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    StokvelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model PickupHub {
  id        String       @id @default(uuid())
  name      String
  address   String
  city      String
  managerId String
  manager   User         @relation("HubManager", fields: [managerId], references: [id])
  pools     BuyingPool[]
  orders    Order[]
}

model Product {
  id           String       @id @default(uuid())
  name         String
  description  String
  unitPrice    Decimal      @db.Decimal(10, 2)
  retailPrice  Decimal      @db.Decimal(10, 2)
  unitQuantity String
  imageUrl     String?
  pools        BuyingPool[]
}

model BuyingPool {
  id              String        @id @default(uuid())
  productId       String
  hubId           String
  groupId         String?
  status          PoolStatus    @default(DRAFT)
  targetQuantity  Int
  currentQuantity Int           @default(0)
  targetAmount    Decimal       @db.Decimal(12, 2)
  currentAmount   Decimal       @db.Decimal(12, 2) @default(0.00)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id])
  hub             PickupHub     @relation(fields: [hubId], references: [id])
  group           StokvelGroup? @relation(fields: [groupId], references: [id])
  orders          Order[]
}

model Order {
  id            String             @id @default(uuid())
  userId        String
  poolId        String
  hubId         String
  quantity      Int
  totalAmount   Decimal            @db.Decimal(10, 2)
  status        OrderStatus        @default(PENDING_PAYMENT)
  collectionOtp String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id])
  pool          BuyingPool         @relation(fields: [poolId], references: [id])
  hub           PickupHub          @relation(fields: [hubId], references: [id])
  escrow        EscrowTransaction?
}

model EscrowTransaction {
  id          String        @id @default(uuid())
  orderId     String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
